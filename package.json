{
  "name": "@vizhub/quadstream",
  "version": "0.2.0",
  "description": "Deterministic, topology-aware progressive geographic geometry engine",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "bin"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prettier": "prettier --write .",
    "lint": "eslint .",
    "test": "npm run build && node --test test/*.test.mjs",
    "check": "npm run typecheck && npm run test",
    "demo:map": "node examples/progressive/server.mjs",
    "test:browser": "npm run build && playwright test",
    "demo:globe": "node examples/progressive/server.mjs --globe",
    "test:globe:browser": "npm run build && playwright test globe.spec.mjs",
    "prepack": "npm run build",
    "test:package": "node scripts/test-package.mjs"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "prettier": "3.10.1",
    "eslint": "10.15.0",
    "@eslint/js": "10.0.1",
    "typescript-eslint": "8.74.0",
    "globals": "17.14.0",
    "maplibre-gl": "6.19.0",
    "@playwright/test": "1.65.1",
    "d3": "7.9.2",
    "topojson-client": "3.1.0",
    "world-atlas": "2.0.2"
  },
  "bin": {
    "quadstream": "./bin/quadstream.mjs"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vizhub-studio/quadstream.git"
  },
  "homepage": "https://github.com/vizhub-studio/quadstream#readme",
  "bugs": {
    "url": "https://github.com/vizhub-studio/quadstream/issues"
  },
  "keywords": [
    "geometry",
    "geojson",
    "topojson",
    "simplification",
    "topology",
    "quadtree",
    "gis",
    "progressive",
    "d3",
    "maplibre"
  ],
  "publishConfig": {
    "access": "public"
  }
}
